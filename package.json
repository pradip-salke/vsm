{
  "name": "vs-medu-platform",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build --workspace=@vsmedu/contracts && npm run build --workspace=@vsmedu/api && npm run build --workspace=@vsmedu/web && npm run build --workspace=@vsmedu/admin",
    "test": "npm run test --workspace=@vsmedu/api",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:seed:home": "tsx scripts/seed-home.ts",
    "db:seed:academics": "tsx scripts/seed-academics.ts",
    "db:seed:academics-aima-specs": "tsx scripts/seed-academics-aima-specs.ts",
    "db:seed:academics-faculty": "tsx scripts/seed-academics-faculty.ts",
    "db:ensure:academic-faq": "tsx scripts/ensure-academic-faq-rows.ts",
    "verify:home": "tsx scripts/verify-home.ts",
    "verify:academics": "tsx scripts/verify-academics.ts",
    "verify:academics-aima": "tsx scripts/verify-academics-aima.ts",
    "db:seed:admissions": "tsx scripts/seed-admissions.ts",
    "db:seed:site-pages": "tsx scripts/seed-site-pages.ts",
    "verify:site-pages": "tsx scripts/verify-site-pages.ts",
    "db:seed:placements": "tsx scripts/seed-placements.ts",
    "db:seed:events": "tsx scripts/seed-events.ts",
    "verify:admissions": "tsx scripts/verify-admissions.ts",
    "verify:academic-faq": "tsx scripts/verify-academic-faq.ts",
    "verify:spec-financial-management": "tsx scripts/verify-specialisation-cms.ts financial-management-specialisation",
    "verify:spec-human-resources": "tsx scripts/verify-specialisation-cms.ts mba-pgdm-in-human-resources-mumbai",
    "verify:spec-marketing": "tsx scripts/verify-specialisation-cms.ts mba-in-marketing-mumbai",
    "verify:spec-business-analytics": "tsx scripts/verify-specialisation-cms.ts pgdm-in-business-analytics-mumbai",
    "verify:spec-operations": "tsx scripts/verify-specialisation-cms.ts operations-and-supply-chain-management-specialisation",
    "verify:academics-faculty": "tsx scripts/verify-academics-faculty.ts",
    "verify:placements": "tsx scripts/verify-placements.ts",
    "verify:events": "tsx scripts/verify-events.ts",
    "verify:seo": "tsx scripts/verify-seo.ts",
    "verify:enquiries": "tsx scripts/verify-enquiries.ts",
    "verify:footer": "tsx scripts/verify-footer.ts",
    "verify:cms-v2": "tsx scripts/verify-cms-v2.ts"
  },
  "devDependencies": {
    "prisma": "^6.19.0",
    "typescript": "^5.9.3"
  },
  "dependencies": { "dotenv": "^16.6.1" }
}
